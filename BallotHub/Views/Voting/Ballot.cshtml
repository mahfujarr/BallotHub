@model BallotHub.Models.BallotViewModel
@{
    ViewData["Title"] = "Ballot - " + Model.ElectionTitle;
}

<div class="my-4">
    <h1>@Model.ElectionTitle</h1>
    <p class="text-muted">Select exactly one candidate for every position.</p>
</div>

@if (TempData["VotingError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Positions.Any(position => position.Candidates.Any()))
{
    <div class="alert alert-warning">This election does not have a complete ballot yet.</div>
}
else
{
    <form asp-action="Submit" method="post">
        <input type="hidden" name="ElectionId" value="@Model.ElectionId" />

        @for (var positionIndex = 0; positionIndex < Model.Positions.Count; positionIndex++)
        {
            var position = Model.Positions[positionIndex];
            <section class="mb-4">
                <h2 class="h4">@position.PositionName</h2>
                @if (!string.IsNullOrWhiteSpace(position.Description))
                {
                    <p class="text-muted">@position.Description</p>
                }

                @if (!position.Candidates.Any())
                {
                    <div class="alert alert-warning">No candidates are available for this position.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var candidate in position.Candidates)
                        {
                            var inputId = $"position-{position.PositionId}-candidate-{candidate.CandidateId}";
                            <label class="list-group-item d-flex gap-3" for="@inputId">
                                <input id="@inputId" class="form-check-input flex-shrink-0" type="radio"
                                       name="Selections[@positionIndex].CandidateId" value="@candidate.CandidateId" required />
                                <span>
                                    <strong>@candidate.Name</strong>
                                    <span class="d-block text-muted">@candidate.Biography</span>
                                </span>
                            </label>
                        }
                    </div>
                }
                <input type="hidden" name="Selections[@positionIndex].PositionId" value="@position.PositionId" />
            </section>
        }

        <button type="submit" class="btn btn-primary">Submit Vote</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to elections</a>
    </form>
}