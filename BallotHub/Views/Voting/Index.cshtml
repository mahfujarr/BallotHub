@model IEnumerable<BallotHub.Models.Election>
@{
    ViewData["Title"] = "Active Elections";
}

<div class="my-4">
    <h1>Active Elections</h1>
    <p class="text-muted">Choose an active election to view its ballot.</p>
</div>

@if (TempData["VotingError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["VotingMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">There are no active elections available for voting.</div>
}
else
{
    <div class="row g-4">
        @foreach (var election in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@election.Title</h2>
                        <p class="text-muted">@election.Description</p>
                        <p class="small">Ends @election.EndDate.ToString("g")</p>
                        <a asp-action="Ballot" asp-route-electionId="@election.Id" class="btn btn-primary mt-auto">View ballot</a>
                    </div>
                </div>
            </div>
        }
    </div>
}