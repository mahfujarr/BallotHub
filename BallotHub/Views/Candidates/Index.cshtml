@model IEnumerable<BallotHub.Models.Candidate>
@{
    ViewData["Title"] = "Candidates";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <div>
        <h1>Candidates</h1>
        <p class="text-muted mb-0">Browse every candidate option across the available elections.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">There are no candidates to display yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var candidate in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 mb-1">@candidate.Name</h2>
                        <p class="small text-primary mb-2">@(candidate.Position?.Name ?? "Unassigned")</p>
                        <p class="text-muted">@candidate.Biography</p>
                        <a asp-controller="Election" asp-action="Details" asp-route-id="@candidate.ElectionId" class="btn btn-outline-primary mt-auto">
                            View @candidate.Election.Title
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}