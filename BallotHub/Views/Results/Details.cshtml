@model BallotHub.Models.ElectionResultsViewModel
@{
    ViewData["Title"] = "Results - " + Model.Election.Title;
}

<h1 class="my-4">@Model.Election.Title results</h1>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Total Votes Cast</h2>
                <p class="display-6 mb-0">@Model.TotalVotesCast</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Unique Voters</h2>
                <p class="display-6 mb-0">@Model.TotalVoters</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 text-muted">Result Generated (UTC)</h2>
                <p class="mb-0">@Model.GeneratedAtUtc.ToString("u")</p>
            </div>
        </div>
    </div>
</div>

@foreach (var positionResult in Model.Positions)
{
    <h2 class="h4 mt-4">@positionResult.Position.Name</h2>
    <p class="text-muted mb-1">Total votes: @positionResult.TotalVotes</p>
    @if (positionResult.IsTie)
    {
        <p class="badge bg-warning text-dark">Tie: @positionResult.WinnerDisplay</p>
    }
    else
    {
        <p class="badge bg-success">Winner: @positionResult.WinnerDisplay</p>
    }

    <div class="list-group">
    @foreach (var result in positionResult.Candidates)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between">
                <strong>
                    @result.Candidate.Name
                    @if (result.IsWinner)
                    {
                        <span class="badge bg-primary ms-2">Top</span>
                    }
                </strong>
                <span>@result.VoteCount vote(s) (@result.VotePercentage.ToString("0.0")%)</span>
            </div>
            <div class="progress mt-2" role="progressbar" aria-label="Vote percentage" aria-valuenow="@result.VotePercentage" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @result.VotePercentage.ToString("0.##")%"></div>
            </div>
        </div>
    }
    </div>
}

<a asp-controller="Results" asp-action="Index" class="btn btn-outline-secondary mt-4">Back to results</a>
