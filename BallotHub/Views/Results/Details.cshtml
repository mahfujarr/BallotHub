@model BallotHub.Models.ElectionResultsViewModel
@{
    ViewData["Title"] = "Results - " + Model.Election.Title;
}

<h1 class="my-4">@Model.Election.Title results</h1>
@foreach (var positionResult in Model.Positions)
{
    var totalVotes = positionResult.Candidates.Sum(candidate => candidate.VoteCount);
    <h2 class="h4 mt-4">@positionResult.Position.Name</h2>
    <p class="text-muted">Total votes: @totalVotes</p>
    <div class="list-group">
    @foreach (var result in positionResult.Candidates)
    {
        var percentage = totalVotes == 0 ? 0 : result.VoteCount * 100.0 / totalVotes;
        <div class="list-group-item">
            <div class="d-flex justify-content-between">
                <strong>@result.Candidate.Name</strong>
                <span>@result.VoteCount vote(s) (@percentage.ToString("0.0")%)</span>
            </div>
            <div class="progress mt-2" role="progressbar" aria-label="Vote percentage" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @percentage.ToString("0.##")%"></div>
            </div>
        </div>
    }
    </div>
}

<a asp-controller="Results" asp-action="Index" class="btn btn-outline-secondary mt-4">Back to results</a>
